# ==============================================================================
# The Job Applicant Perspective (TJAP) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local execution:
#   cp .env.example .env.local
#
# DO NOT commit .env.local or any file containing active credentials to Git.
# ==============================================================================

# Server-Side Delivery API Token (used in src/lib/storyblok.ts and RSC data fetching)
# Generated in Storyblok Space Settings -> Access Tokens (Read-only Delivery Token)
STORYBLOK_DELIVERY_API_TOKEN=your_storyblok_delivery_token_here

# Client-Side Delivery API Token (inlined into client bundle for StoryblokProvider live visual bridge)
# NOTE: Must be a Public/Delivery token ONLY. Never use a Management or Personal Access Token here.
NEXT_PUBLIC_STORYBLOK_TOKEN=your_storyblok_delivery_token_here

# Storyblok Space Region ('eu' for Europe / default spaces, 'us' for North American spaces)
STORYBLOK_REGION=eu
NEXT_PUBLIC_STORYBLOK_REGION=eu

# Optional: Upstash Redis (Required for Tier 4 Rate Limiting)
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here