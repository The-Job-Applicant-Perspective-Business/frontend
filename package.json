{
  "name": "the-job-applicant-perspective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"NEXT,TSC\" -c \"bgBlue.bold,bgCyan.bold\" \"next dev\" \"tsc --noEmit --watch --preserveWatchOutput\"",
    "dev:full": "concurrently -n \"NEXT,TSC,SUPA\" -c \"bgBlue.bold,bgCyan.bold,bgGreen.bold\" \"next dev\" \"tsc --noEmit --watch --preserveWatchOutput\" \"npx supabase start\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "verify": "npm run lint && tsc --noEmit --pretty false",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@storyblok/react": "^7.3.1",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.4",
    "dotenv": "^17.4.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
